									"userProperties": [],
									"typeProperties": {
										"message": "Inner Pipeline Failed",
										"errorCode": "500"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
