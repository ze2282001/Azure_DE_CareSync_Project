{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "vk-adf-caresync"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://vkcaresyncproject.dfs.core.windows.net/"
		},
		"ls_azure_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1009-040454-5y8eeisb"
		},
		"ls_azure_key_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://vk-carsync-keyvault.vault.azure.net/"
		},
		"ls_azuresqldatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "vk-server-caresync.database.windows.net"
		},
		"ls_azuresqldatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "vk-sql-db-caresync"
		},
		"ls_azuresqldatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "vk-admin"
		},
		"ls_neon_postgresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-holy-cloud-b7if84zi-pooler.c-13.us-east-1.aws.neon.tech"
		},
		"ls_neon_postgresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_neon_postgresql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "vk-adf-caresync_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_azure_key_vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_azure_key_vault_properties_typeProperties_baseUrl')]"
					},
					"ls_azure_databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_azure_databricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_azuresqldatabase_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresqldatabase_properties_typeProperties_server')]"
					},
					"ls_azuresqldatabase_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresqldatabase_properties_typeProperties_database')]"
					},
					"ls_azuresqldatabase_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresqldatabase_properties_typeProperties_userName')]"
					},
					"ls_neon_postgresql_properties_typeProperties_server": {
						"value": "[parameters('ls_neon_postgresql_properties_typeProperties_server')]"
					},
					"ls_neon_postgresql_properties_typeProperties_database": {
						"value": "[parameters('ls_neon_postgresql_properties_typeProperties_database')]"
					},
					"ls_neon_postgresql_properties_typeProperties_username": {
						"value": "[parameters('ls_neon_postgresql_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}